/* Rist TUI v2 identity */
Screen {
    layout: vertical;
    background: #0f1419;
    color: #d8dee9;
}

#topbar {
    height: 3;
    padding: 0 1;
    background: #121a22;
    border-bottom: solid #263241;
    layout: horizontal;
}

#brand {
    width: 1fr;
    content-align: left middle;
    text-style: bold;
    color: #8fbcbb;
}

#status {
    width: auto;
    min-width: 70;
    content-align: right middle;
    color: #a7b0bd;
}

#workspace {
    height: 1fr;
    layout: horizontal;
    padding: 1 1 0 1;
}

#conversation {
    width: 2fr;
    min-width: 50;
    padding-right: 1;
}

#activity {
    width: 1fr;
    max-width: 48;
    min-width: 28;
    border-left: solid #263241;
    padding-left: 1;
}

.panel-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

#log, #activity-log {
    height: 1fr;
    background: #0f1419;
}

#activity-log {
    scrollbar-size: 1 1;
}

#live {
    padding: 0 1;
    margin-top: 1;
    border-left: thick #8fbcbb;
    color: #d8dee9;
    max-height: 8;
}

#live.empty {
    display: none;
}

#confidence-strip {
    height: 8;
    border-top: solid #263241;
    border-bottom: solid #263241;
    padding: 0 1;
}

#runtime-panel {
    height: 100%;
    color: #c7d0dc;
}

#input {
    height: 3;
    margin: 0 1;
    border: tall #5e81ac;
    background: #111820;
}

Footer {
    background: #121a22;
    color: #7f8b99;
}

ConfirmScreen {
    align: center middle;
}

#confirm-box {
    width: 80;
    height: auto;
    padding: 1 2;
    border: thick #d08770;
    background: #151d26;
}

#confirm-title {
    text-style: bold;
    color: #ebcb8b;
}

#confirm-label {
    margin: 1 0;
}

#confirm-content {
    max-height: 18;
    overflow-y: auto;
}

#confirm-buttons {
    height: auto;
    align: center middle;
}

#confirm-buttons Button {
    margin: 1 2;
}

CommandPaletteScreen {
    align: center middle;
    background: #0f141980;
}

#palette-box {
    width: 74;
    max-height: 24;
    padding: 1 2;
    background: #151d26;
    border: round #5e81ac;
}

#palette-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

#palette-search {
    height: 3;
    margin: 1 0;
    border: tall #263241;
    background: #111820;
}

#palette-list {
    height: auto;
    max-height: 16;
    color: #d8dee9;
}

DiffReviewScreen {
    align: center middle;
    background: #0f141980;
}

#review-box {
    width: 92%;
    height: 88%;
    padding: 1 2;
    background: #151d26;
    border: round #5e81ac;
}

#review-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

#review-summary {
    height: 5;
    border-bottom: solid #263241;
}

#review-main {
    height: 1fr;
}

#review-files {
    width: 32;
    min-width: 24;
    padding: 1;
    border-right: solid #263241;
    overflow-y: auto;
}

#review-diff {
    width: 1fr;
    padding: 1 2;
    overflow: auto;
}

#review-actions {
    height: 4;
    align: center middle;
    border-top: solid #263241;
}

#review-actions Button {
    margin: 1 2;
}

RuntimeStatusScreen, DoctorResultsScreen, BenchmarkResultsScreen {
    align: center middle;
    background: #0f141980;
}

#result-box {
    width: 86%;
    height: 82%;
    padding: 1 2;
    background: #151d26;
    border: round #5e81ac;
}

.result-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

.result-body {
    height: auto;
    margin-top: 1;
}

.result-details {
    height: 1fr;
    margin-top: 1;
    padding-top: 1;
    border-top: solid #263241;
    overflow: auto;
}

.result-hint {
    height: 1;
    color: #7f8b99;
}

RepositoryExplorerScreen {
    align: center middle;
    background: #0f141980;
}

#repo-box {
    width: 92%;
    height: 88%;
    padding: 1 2;
    background: #151d26;
    border: round #5e81ac;
}

#repo-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

#repo-project {
    height: 3;
    border-bottom: solid #263241;
}

#repo-search {
    height: 3;
    margin: 1 0;
    border: tall #263241;
    background: #111820;
}

#repo-main { height: 1fr; }

#repo-tree {
    width: 42%;
    min-width: 32;
    padding: 1;
    border-right: solid #263241;
    overflow: auto;
}

#repo-side { width: 1fr; }

#repo-details {
    height: 10;
    padding: 1 2;
    border-bottom: solid #263241;
}

#repo-preview {
    height: 1fr;
    padding: 1 2;
    overflow: auto;
}

#repo-hint {
    height: 1;
    color: #7f8b99;
}

DecisionBrowserScreen {
    align: center middle;
    background: #0f141980;
}

#decision-box {
    width: 92%;
    height: 86%;
    padding: 1 2;
    background: #151d26;
    border: round #5e81ac;
}

#decision-title {
    height: 1;
    color: #8fbcbb;
    text-style: bold;
}

#decision-filters {
    height: 1;
    margin-top: 1;
}

#decision-search {
    height: 3;
    margin: 1 0;
    border: tall #263241;
    background: #111820;
}

#decision-main {
    height: 1fr;
}

#decision-list {
    width: 2fr;
    min-width: 40;
    padding: 1;
    border-right: solid #263241;
    overflow-y: auto;
}

#decision-details {
    width: 3fr;
    padding: 1 2;
    overflow: auto;
}

#decision-hint {
    height: 1;
    color: #7f8b99;
}
